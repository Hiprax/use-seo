{
  "name": "@hiprax/use-seo",
  "version": "0.3.3",
  "description": "A production-ready React hook for managing SEO and social meta tags with full TypeScript support",
  "author": "Hiprax",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hiprax/use-seo.git"
  },
  "bugs": {
    "url": "https://github.com/Hiprax/use-seo/issues"
  },
  "homepage": "https://github.com/Hiprax/use-seo#readme",
  "funding": "https://github.com/sponsors/Hiprax",
  "keywords": [
    "react",
    "seo",
    "meta-tags",
    "open-graph",
    "twitter-card",
    "json-ld",
    "structured-data",
    "react-hook",
    "typescript",
    "canonical",
    "robots",
    "hreflang",
    "next-seo",
    "react-helmet",
    "head",
    "metadata",
    "nextjs",
    "og-image",
    "hook"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check-types-pack": "attw --pack .",
    "verify": "node scripts/verify.mjs",
    "branch": "node scripts/new-branch.mjs",
    "sync": "node scripts/sync-main.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:tag": "node scripts/release-tag.mjs",
    "prepublishOnly": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check-types-pack",
    "clean": "rimraf dist coverage"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
