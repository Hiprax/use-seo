; Project npm config.
;
; `legacy-peer-deps=true` is required because `eslint-plugin-react@7.37.5`
; (the latest release) still caps its `eslint` peer at `^9.7`, while this
; project tracks `eslint@^10.3.0`. The plugin works fine against ESLint 10
; in practice; this flag suppresses the peer-dep ERESOLVE during install.
; Drop this line once eslint-plugin-react ships an ESLint-10-aware release.
legacy-peer-deps=true
; Keep installs quiet about funding messages; CI logs are noisy enough.
fund=false
; npm pack / publish should always include declared `files` only - belt + braces.
ignore-scripts=false
